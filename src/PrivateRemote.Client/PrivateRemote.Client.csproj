<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrivateRemote.Protocol\PrivateRemote.Protocol.csproj" />
    <ProjectReference Include="..\PrivateRemote.Transfer\PrivateRemote.Transfer.csproj" />
    <ProjectReference Include="..\PrivateRemote.Transport\PrivateRemote.Transport.csproj" />
    <ProjectReference Include="..\PrivateRemote.Relay\PrivateRemote.Relay.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../artifacts/native/datachannel.dll')">
    <Content Include="../../artifacts/native/**/*" Link="native/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
