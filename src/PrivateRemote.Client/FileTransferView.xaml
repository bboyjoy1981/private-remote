<Window x:Class="PrivateRemote.Client.FileTransferView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件传输" Height="390" Width="560" MinHeight="340" MinWidth="480"
        Background="#F4F6FA" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="文件传输" FontSize="23" FontWeight="SemiBold" Foreground="#172033" />
            <TextBlock x:Name="SessionLabel" Text="加密会话已建立" Margin="0,5,0,0" Foreground="#64748B" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,18,0,12">
            <StackPanel>
                <TextBlock x:Name="TransferStatus" Text="选择要发送的文件，或等待对方发送文件。" FontWeight="SemiBold" Foreground="#172033" TextWrapping="Wrap" />
                <TextBlock x:Name="TransferDetails" Text="接收的文件需由你选择保存位置；文件不会自动打开或运行。" Margin="0,5,0,12" Foreground="#64748B" TextWrapping="Wrap" />
                <ProgressBar x:Name="TransferProgress" Minimum="0" Maximum="100" Height="8" />
                <TextBlock x:Name="ProgressLabel" Text="" Margin="0,7,0,0" FontSize="12" Foreground="#64748B" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FFF7ED" CornerRadius="10" Padding="12" VerticalAlignment="Top">
            <TextBlock Text="仅在配对设备的加密会话中传输。接收前请核对文件名与大小。" Foreground="#9A3412" TextWrapping="Wrap" />
        </Border>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="FooterStatus" Text="就绪" VerticalAlignment="Center" Foreground="#64748B" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="取消传输" IsEnabled="False" Padding="14,8" Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button x:Name="SendButton" Content="发送文件…" Padding="14,8" Click="SendButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
